LOG_LEVEL=INFO
DATA_DIR=./data
GROQ_API_KEY=
OPENAI_API_KEYS=  # comma-separated; first is primary, the rest are fallbacks on 4xx/5xx
OPENAI_MODEL=gpt-4o
OPENAI_STT_MODEL=gpt-realtime-whisper  # dictation; live words. gpt-4o-mini-transcribe is ~6x cheaper, text after a pause
OPENAI_IMAGE_DETAIL=low  # low | auto | high; low is ~3x cheaper per frame
OPENAI_BASE_URL=https://api.openai.com/v1  # any OpenAI-compatible endpoint
# USD per 1M tokens for OPENAI_MODEL; the cost counter on the page is computed from these
OPENAI_PRICE_IN=2.50
OPENAI_PRICE_CACHED=1.25
OPENAI_PRICE_OUT=10.00
MAX_WATCHES=5
PORT=8000
TELEGRAM_BOT_TOKEN=
CONVEX_URL=  # https://<deployment>.convex.cloud
WORKER_SECRET=  # same value as `npx convex env set WORKER_SECRET ...`; openssl rand -hex 32
FRONTEND_ORIGIN=  # https://<deployment>.convex.site when the page is hosted on Convex

OPENAI_REQUEST_TIMEOUT=10
OPENAI_ATTEMPT_TIMEOUT=5
