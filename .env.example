LOG_LEVEL=INFO
DATA_DIR=./data
GROQ_API_KEY=
OPENAI_API_KEYS=  # comma-separated; first is primary, the rest are fallbacks on 4xx/5xx
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1  # any OpenAI-compatible endpoint
# USD per 1M tokens for OPENAI_MODEL; the cost counter on the page is computed from these
OPENAI_PRICE_IN=2.50
OPENAI_PRICE_CACHED=1.25
OPENAI_PRICE_OUT=10.00
MAX_SESSIONS=10
SESSION_TTL=30
MAX_WATCHES=5
MAX_SUBSCRIBERS=100
SUBSCRIBER_TTL=86400
PORT=8000
TELEGRAM_BOT_TOKEN=

OPENAI_REQUEST_TIMEOUT=10
OPENAI_ATTEMPT_TIMEOUT=5
